# Local development: the backend on this machine.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_PREFIX=/api/v1

# Deployed (Vercel) — both of these are read at BUILD time and inlined into
# the client bundle, so changing either one needs a redeploy, not just an
# env-var edit. Two hard requirements:
#
#   1. https, not http. The app is served over TLS and a browser blocks a
#      plain-http fetch from an https page as mixed content.
#   2. A host the visitor's browser can reach. 127.0.0.1 is the visitor's own
#      machine, so it can never reach your backend.
#
# NEXT_PUBLIC_API_BASE_URL=https://api.lensai.example.com
# NEXT_PUBLIC_API_PREFIX=/api/v1
